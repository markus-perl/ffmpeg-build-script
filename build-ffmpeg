build_zlib() {
    if build "zlib" "${VER_ZLIB[0]}"; then
        download "https://github.com/madler/zlib/releases/download/v$CURRENT_PACKAGE_VERSION/zlib-$CURRENT_PACKAGE_VERSION.tar.gz"
