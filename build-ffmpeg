fi

if build "m4" "1.4.21"; then
    download "https://ftp.gnu.org/gnu/m4/m4-$CURRENT_PACKAGE_VERSION.tar.gz"
    execute ./configure --prefix="${WORKSPACE}"
    execute make -j "$MJOBS"
