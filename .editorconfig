root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# shell scripts are formatted with shfmt, which reads these keys
[{build-ffmpeg,*.sh}]
indent_style = space
indent_size = 4
binary_next_line = false
switch_case_indent = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
